
{%- style -%}
.text-center {
  text-align: center;
}
{%- endstyle -%}
<div class="make-statement-section section-{{ section.id }}-padding text-center">
  <h2> {{ section.settings.custom_text_title }} </h2>
</div>

{% schema %}
  {
    "name": "Make Statement",
    "settings": [
      {
        "id": "custom_text_title",
        "type": "text",
        "label": "Text box heading",
        "default": "Title"
      },
      {
        "id": "custom_text_body",
        "type": "richtext",
        "label": "Add custom text below",
        "default": "<p>Add your text here</p>"
      }
    ],
    "presets": [
      {
        "name": "make-statement",
        "category": "Custom"
      }
    ]
  }
{% endschema %}